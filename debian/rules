#!/usr/bin/make -f
# Roj is JavaScript, data and fonts: nothing to compile. The Makefile's
# install-system target lays out both packages; *.install files split them.

%:
	dh $@

override_dh_auto_build:

override_dh_auto_test:

override_dh_auto_install:
	$(MAKE) install-system DESTDIR=$(CURDIR)/debian/tmp PREFIX=/usr
